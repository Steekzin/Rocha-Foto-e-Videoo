{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?path=$1"
    },
    {
      "source": "/portfolio/(.*)",
      "destination": "/api?portfolioPath=$1"
    },
    {
      "source": "/((?!api/|portfolio/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
