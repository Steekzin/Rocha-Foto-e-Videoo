# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - ROCHA FOTO & VÍDEO
# Funciona localmente, em VPS, Vercel, Docker e na plataforma Google Studio
# ==============================================================================

# Servidor & Porta (Padrão 3000)
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ==============================================================================
# BANCO DE DADOS SUPABASE (PostgreSQL na Nuvem)
# Obtenha estas informações em: https://supabase.com/dashboard -> Project Settings -> API
# Caso não preenchidas, a aplicação roda automaticamente com banco local (data/rocha_db.json)
# ==============================================================================
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-aqui

# ==============================================================================
# VARIÁVEIS PÚBLICAS PARA O CLIENTE VITE (Frontend)
# Devem ter o prefixo VITE_ para serem lidas no navegador
# ==============================================================================
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

